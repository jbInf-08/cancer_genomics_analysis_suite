# Local credentials for docker-compose. Copy to .env and fill in:
#
#   cp .env.example .env
#
# .env is gitignored. Compose reads it automatically from this directory.
#
# Generate all four at once:
#
#   { echo "POSTGRES_PASSWORD=$(openssl rand -base64 24)"
#     echo "SECRET_KEY=$(openssl rand -base64 48)"
#     echo "KEYCLOAK_ADMIN_PASSWORD=$(openssl rand -base64 24)"
#     echo "GRAFANA_ADMIN_PASSWORD=$(openssl rand -base64 24)"; } > .env
#
# The compose files reference these as ${VAR:?...}, so `docker compose up` stops
# with a message naming the missing variable instead of starting on a default.
# That matters more than it looks: docker-compose.advanced.yml publishes
# Postgres on 5432, Keycloak on 8081 and Grafana on 3000 to the host, and those
# services previously came up as postgres/postgres, admin/admin and admin --
# reachable by anything that can route to the machine, not just localhost.

# PostgreSQL. Used by the database container, by the app's DATABASE_URL, and as
# Keycloak's KC_DB_PASSWORD, so one value covers all three.
POSTGRES_PASSWORD=

# Flask session signing key for the app container.
SECRET_KEY=

# Keycloak admin console (docker-compose.advanced.yml only).
KEYCLOAK_ADMIN_PASSWORD=

# Grafana admin login (docker-compose.advanced.yml only).
GRAFANA_ADMIN_PASSWORD=
