# Copy to secrets.yaml in this directory and fill in every value.
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml is gitignored and listed in kustomization.yaml under resources,
# so kustomize picks it up from your working copy and it never reaches the
# repository. Until it exists, `kubectl kustomize k8s/` stops with an
# evalsymlink failure naming secrets.yaml but not explaining it.
#
# What has to be here is postgres-secrets: the deployments read those three
# keys and nothing in the repository creates them.
#
# Values under stringData are written as-is, so there is no base64 step. Use
# stringData rather than data unless you are pasting values that are already
# encoded.
#
# Generate the password with:
#
#   openssl rand -base64 32
#
# POSTGRES_PASSWORD must match DATABASE_PASSWORD in secrets.env, which is what
# the application authenticates with.
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: cancer-genomics
type: Opaque
stringData:
  POSTGRES_DB: cancer_genomics
  POSTGRES_USER: cancer_genomics
  POSTGRES_PASSWORD: ""
