# Copy to secrets.env in this directory and fill in every value.
#
#   cp secrets.env.example secrets.env
#
# secrets.env is gitignored. Do not commit it, and do not paste real values
# back into this example.
#
# The values are deliberately left empty rather than pre-filled. Copying this
# file unedited produces empty keys, and the application fails to start -- which
# is the outcome you want. A file of plausible-looking defaults is how the
# previous version ended up signing production tokens with a string published
# in the repository.
#
# Generate each of these with:
#
#   openssl rand -base64 48
#
# Flask session signing key. Anyone holding it can forge a session cookie.
SECRET_KEY=
#
# JWT signing key. Anyone holding it can mint a token for any user.
JWT_SECRET_KEY=
#
# Password the application uses to reach PostgreSQL. Must match the
# POSTGRES_PASSWORD in postgres-secrets (see secrets.yaml.example), or the
# application authenticates against a database that expects a different one.
DATABASE_PASSWORD=
