[flake8]
# Match black, which pyproject.toml sets to 88. Without this flake8 uses its
# own 79-character default, so black's output was itself producing thousands of
# E501s -- the two tools were formatting to different targets.
max-line-length = 88

# E203 and W503 are black-incompatible by design and black's own documentation
# recommends disabling them:
#   E203 whitespace before ':'   -- black puts it there in slices
#   W503 line break before binary operator -- black prefers breaking before
#
# E402 module level import not at top of file. Of the 170 it reported, 169 were
# imports that have to sit where they are:
#
#   109  below a warnings.filterwarnings("ignore") that exists to silence those
#        imports. Hoisting them past it un-silences the warnings, which is a
#        behaviour change dressed up as a lint fix.
#    57  below a sys.path.insert that makes the import resolvable at all.
#        Hoisting them breaks the import outright.
#     3  deliberate deferrals: two in app/auth/__init__.py, which imports .models
#        and .routes at the bottom to break a circular import that routes.py has
#        an explicit fallback for, and one after a pytest.importorskip, which
#        must run before the module it guards is imported.
#
# The one genuine case -- an `import sys` sitting below a class definition in
# modules/demo_module/demo_dash.py -- is fixed rather than ignored. A rule
# firing 169 times out of 170 on correct code reports nothing useful, so it is
# off; a misplaced import is caught in review instead.
#
# E501 line too long. black is the formatter of record here and targets 88, so
# every line E501 reports is a line black produced and chose not to split.
# black splits everything it can; what it cannot split is string content and
# comment text. That means E501 only ever fires where black has already given
# up, and turning it off loses no coverage black is not already providing.
#
# Measured across the 814 it reported, in 177 files:
#
#   767  (94.2%)  inside a string literal. Many are embedded documents -- CSS,
#                 a Snakefile, a Makefile, docker-compose YAML, LLM prompts,
#                 tab-delimited BED and GFF records built with f-strings.
#                 Wrapping those changes the file the program writes out, not
#                 just the source. The Makefile in scripts/ already needed a
#                 per-file-ignore below for the same reason.
#    23  ( 2.8%)  comment text. Editable, but reflowing prose in 20 files buys
#                 nothing once the rule is off.
#    24  ( 2.9%)  code, and none of it reformattable:
#                   21  in omics_definitions/omics_dashboard.py, where the
#                       content is a bare "{" or "}," and the *indentation*
#                       is 88 columns on its own -- 22 levels of nesting in a
#                       Dash layout. Only restructuring that function shortens
#                       them, which is a refactor of working UI code.
#                    3  `from CancerGenomicsSuite.modules.pipeline_orchestration
#                       .md_workflow_dash_display import (` -- the module path
#                       alone is 75 characters, so the statement cannot fit in
#                       88 without renaming the module.
#
# So nothing here is fixable by formatting. max-line-length stays at 88 above
# because that is what black is told to target; this only stops flake8
# re-reporting black's own output.
extend-ignore = E203, W503, E402, E501

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    node_modules

per-file-ignores =
    # Package __init__ files re-export names for their callers; pyflakes counts
    # that as an unused import.
    __init__.py:F401

    # This module writes out a Makefile, held as a triple-quoted f-string. Every
    # recipe line in it must start with a literal tab -- make rejects spaces
    # with "missing separator. Stop." W191/E101 are physical-line checks that do
    # not skip string contents, so they flag the Makefile body as though it were
    # Python indentation. Converting those tabs would produce a broken Makefile.
    CancerGenomicsSuite/scripts/setup_auto_generation.py:W191,E101
